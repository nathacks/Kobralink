{
    "name": "kobralink",
    "version": "0.1.2",
    "private": true,
    "packageManager": "bun@1.4.2",
    "scripts": {
        "dev": "bunx turbo run dev",
        "dev:web": "bunx turbo run dev --filter=@kobralink/api --filter=@kobralink/web",
        "dev:desktop": "bunx turbo run dev --filter=@kobralink/desktop...",
        "build": "bunx turbo run build",
        "check-types": "bunx turbo run check-types",
        "test": "bunx turbo run test",
        "lint": "bunx biome check .",
        "format": "bunx biome format --write .",
        "db:migrate": "bun run --filter @kobralink/api db:migrate",
        "db:generate": "bun run --filter @kobralink/api db:generate",
        "db:studio": "bun run --filter @kobralink/api db:studio",
        "prepare": "bunx husky"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/bun": "^1.4.2",
        "husky": "^9.1.7",
        "turbo": "^2.5.8",
        "typescript": "catalog:"
    },
    "engines": {
        "bun": ">=1.4.2"
    },
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*"
        ],
        "catalog": {
            "typescript": "^7.0.2",
            "@types/node": "^24.0.0",
            "zod": "^4.6.4",
            "better-auth": "^1.7.4",
            "mqtt": "^5.14.0",
            "tsdown": "^0.23.0",
            "vite": "^8.3.0",
            "@inlang/paraglide-js": "^2.25.2"
        },
        "catalogs": {
            "nest": {
                "typescript": "^5.9.3"
            }
        }
    },
    "trustedDependencies": [
        "@biomejs/biome",
        "@ffmpeg-installer/darwin-arm64",
        "@ffmpeg-installer/darwin-x64",
        "@ffmpeg-installer/linux-arm64",
        "@ffmpeg-installer/linux-x64",
        "@ffmpeg-installer/win32-x64",
        "@nestjs/core",
        "@prisma/engines",
        "@tailwindcss/oxide",
        "electron",
        "esbuild",
        "prisma"
    ]
}
