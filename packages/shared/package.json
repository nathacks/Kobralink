{
    "name": "@kobralink/shared",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bunx tsdown",
        "dev": "bunx tsdown --watch",
        "check-types": "bunx tsc --noEmit"
    },
    "dependencies": {
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "tsdown": "^0.15.0",
        "typescript": "^5.9.3"
    }
}
