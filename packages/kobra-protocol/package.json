{
    "name": "@kobralink/kobra-protocol",
    "version": "0.1.0",
    "private": true,
    "description": "Anycubic Kobra X LAN protocol: MQTT client, credential fetch, GCode upload, GCode metadata parsing.",
    "license": "GPL-3.0-only",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bunx tsdown",
        "dev": "bunx tsdown --watch",
        "check-types": "bunx tsc --noEmit",
        "test": "bun test"
    },
    "dependencies": {
        "mqtt": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    }
}
