generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  role               String              @default("admin")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  apikeys            Apikey[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Printer {
  id                    String                 @id @default(cuid())
  name                  String
  ip                    String
  mqttPort              Int                    @default(9883)
  username              String
  password              String
  deviceId              String
  modeId                String                 @default("20030")
  model                 String                 @default("Anycubic Kobra X")
  httpPort              Int                    @unique
  settings              String                 @default("{}")
  awaitingBedClear      Boolean                @default(false)
  maintenance           Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  files                 GcodeFile[]
  jobs                  PrintJob[]
  slotProfiles          SlotProfile[]
  spoolAssignments      SpoolAssignment[]
  localSpoolAssignments LocalSpoolAssignment[]
  timelapses            Timelapse[]
  queueItems            QueueItem[]
  scheduledDries        ScheduledDry[]
  scheduledPrints       ScheduledPrint[]
  maintenanceTasks      MaintenanceTask[]
  automationRules       AutomationRule[]

  @@map("printer")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(false)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

model SpoolAssignment {
  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)
  slotIndex Int
  spoolId   Int

  @@id([printerId, slotIndex])
  @@map("spool_assignment")
}

model FilamentProfile {
  id         String   @id @default(cuid())
  filamentId String
  name       String
  vendor     String
  type       String
  color      String   @default("")
  createdAt  DateTime @default(now())

  @@unique([vendor, name])
  @@map("filament_profile")
}

model SlotProfile {
  printerId  String
  printer    Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)
  slotIndex  Int
  vendor     String
  name       String
  filamentId String  @default("")

  @@id([printerId, slotIndex])
  @@map("slot_profile")
}

model GcodeFile {
  id               String           @id
  printerId        String?
  printer          Printer?         @relation(fields: [printerId], references: [id], onDelete: SetNull)
  filename         String
  sizeBytes        Int
  md5              String
  estPrintTimeSec  Int              @default(0)
  layerHeight      Float            @default(0)
  firstLayerHeight Float            @default(0)
  thumbnail        String?
  filaments        String           @default("[]")
  objects          String           @default("[]")
  svgImage         String?
  webUnverified    Boolean          @default(false)
  printerModel     String           @default("")
  nozzleMm         Float?
  bedX             Float?
  bedY             Float?
  extentX          Float?
  extentY          Float?
  maxZ             Float?
  metaVersion      Int              @default(0)
  createdAt        DateTime         @default(now())
  jobs             PrintJob[]
  queueItems       QueueItem[]
  scheduledPrints  ScheduledPrint[]

  @@index([filename])
  @@map("gcode_file")
}

model PrintJob {
  id             String      @id @default(cuid())
  printerId      String
  printer        Printer     @relation(fields: [printerId], references: [id], onDelete: Cascade)
  fileId         String?
  file           GcodeFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  filename       String
  status         String      @default("printing")
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  durationSec    Int?
  estimatedSec   Int         @default(0)
  filamentMm     Float       @default(0)
  spoolUsage     String      @default("[]")
  usageState     String      @default("")
  errorCode      Int         @default(0)
  errorMsg       String      @default("")
  failureReason  String      @default("")
  note           String      @default("")
  snapshot       String?
  pausedAt       DateTime?
  energyStartKwh Float?
  energyKwh      Float?
  timelapses     Timelapse[]

  @@index([printerId, startedAt])
  @@map("print_job")
}

model Timelapse {
  id          String    @id @default(cuid())
  printerId   String
  printer     Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  jobId       String?
  job         PrintJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  filename    String
  frames      Int       @default(0)
  sizeBytes   Int       @default(0)
  durationSec Float     @default(0)
  status      String    @default("recording")
  createdAt   DateTime  @default(now())

  @@index([printerId, createdAt])
  @@map("timelapse")
}

model QueueItem {
  id              String    @id @default(cuid())
  printerId       String?
  printer         Printer?  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  targetTags      String    @default("[]")
  fileId          String
  file            GcodeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position        Int
  excludedObjects String    @default("[]")
  options         String    @default("{}")
  createdAt       DateTime  @default(now())

  @@index([position])
  @@map("queue_item")
}

model LocalSpool {
  id             String                 @id @default(cuid())
  name           String
  vendor         String                 @default("")
  material       String
  colorHex       String                 @default("#808080")
  diameterMm     Float                  @default(1.75)
  densityGcm3    Float                  @default(1.24)
  initialWeightG Float                  @default(1000)
  price          Float                  @default(0)
  usedMm         Float                  @default(0)
  archived       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  lastUsedAt     DateTime?
  assignments    LocalSpoolAssignment[]

  @@map("local_spool")
}

model LocalSpoolAssignment {
  printerId String
  printer   Printer    @relation(fields: [printerId], references: [id], onDelete: Cascade)
  slotIndex Int
  spoolId   String
  spool     LocalSpool @relation(fields: [spoolId], references: [id], onDelete: Cascade)

  @@id([printerId, slotIndex])
  @@map("local_spool_assignment")
}

model Macro {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("zap")
  actions   String   @default("[]")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("macro")
}

model ScheduledDry {
  id         String   @id @default(cuid())
  printerId  String
  printer    Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  aceId      Int?
  startAt    DateTime
  targetTemp Int
  duration   Int
  createdAt  DateTime @default(now())

  @@index([printerId, startAt])
  @@map("scheduled_dry")
}

model ScheduledPrint {
  id        String    @id @default(cuid())
  printerId String
  printer   Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  fileId    String
  file      GcodeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  startAt   DateTime
  options   String    @default("{}")
  createdAt DateTime  @default(now())

  @@index([printerId, startAt])
  @@map("scheduled_print")
}

model MaintenanceTask {
  id            String           @id @default(cuid())
  printerId     String
  printer       Printer          @relation(fields: [printerId], references: [id], onDelete: Cascade)
  name          String
  presetKey     String           @default("")
  note          String           @default("")
  intervalHours Float            @default(0)
  intervalJobs  Int              @default(0)
  intervalDays  Int              @default(0)
  lastDoneAt    DateTime?
  dueNotifiedAt DateTime?
  createdAt     DateTime         @default(now())
  logs          MaintenanceLog[]

  @@index([printerId])
  @@map("maintenance_task")
}

model MaintenanceLog {
  id     String          @id @default(cuid())
  taskId String
  task   MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneAt DateTime        @default(now())
  note   String          @default("")
  hours  Float           @default(0)
  jobs   Int             @default(0)

  @@index([taskId, doneAt])
  @@map("maintenance_log")
}

model SpoolmanPendingUse {
  id        String   @id @default(cuid())
  spoolId   Int
  lengthMm  Float
  printerId String   @default("")
  createdAt DateTime @default(now())

  @@map("spoolman_pending_use")
}

model AutomationRule {
  id         String    @id @default(cuid())
  name       String
  enabled    Boolean   @default(true)
  trigger    String
  time       String    @default("")
  printerId  String?
  printer    Printer?  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  targetTags String    @default("[]")
  actions    String    @default("[]")
  lastRunAt  DateTime?
  lastError  String    @default("")
  createdAt  DateTime  @default(now())

  @@index([trigger])
  @@map("automation_rule")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String?
  clientCredentialsScopes          String?
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String
  postLogoutRedirectUris           String?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String?
  responseTypes                    String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         String?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      String?
  clients                       OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   String?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String?
  requestedUserInfoClaims String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String?
  requestedUserInfoClaims String?
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            String?
  scopes                  String

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String?
  requestedUserInfoClaims String?
  scopes                  String
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}
