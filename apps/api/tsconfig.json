{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2023",
        "lib": ["ES2023"],
        "types": ["node"],
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "outDir": "./dist",
        "sourceMap": true,
        "incremental": true,
        "strictPropertyInitialization": false,
        "isolatedModules": false
    },
    "include": ["src", "prisma.config.ts"]
}
