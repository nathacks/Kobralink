# Dossier de données (SQLite, GCode store). Défaut: <repo>/data
KOBRALINK_DATA_DIR=
# Port HTTP de l'UI + API. Défaut: 7100
KOBRALINK_PORT=7100
# URL publique de l'API (cookies Better Auth). Défaut: http://localhost:7100
BETTER_AUTH_URL=http://localhost:7100
# Secret de session. Généré et persisté dans <data>/.auth-secret si absent.
BETTER_AUTH_SECRET=
