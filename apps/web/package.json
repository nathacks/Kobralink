{
    "name": "@kobralink/web",
    "version": "0.1.5",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bunx --bun vite --port 5173 --strictPort",
        "generate": "bunx tsr generate && bunx paraglide-js compile --project ../../packages/i18n/project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --output-structure message-modules --emit-ts-declarations --no-emit-readme --no-emit-prettier-ignore",
        "build": "bunx --bun vite build && bunx tsc -b",
        "preview": "bunx --bun vite preview",
        "check-types": "bun run generate && bunx tsc -b"
    },
    "dependencies": {
        "@fontsource-variable/outfit": "^5.3.0",
        "@kobralink/shared": "workspace:*",
        "@radix-ui/react-slot": "^1.3.3",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-router": "^1.170.36",
        "@tanstack/react-store": "^0.11.1",
        "@thesvg/react": "^3.3.7",
        "better-auth": "catalog:",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.3.0",
        "lucide-react": "^1.45.0",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-grid-layout": "^2.2.4",
        "recharts": "3.8.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "three": "^0.186.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "catalog:",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-cli": "^1.167.36",
        "@tanstack/router-plugin": "^1.168.38",
        "@types/node": "catalog:",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
